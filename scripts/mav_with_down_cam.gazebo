<?xml version="1.0"?>
<!--
  mav_with_down_cam.gazebo
  Extends mav_with_vi_sensor.gazebo (iris + forward vi_sensor) with a
  downward-facing RGB camera for AprilTag precision landing.

  Added topic: /iris/camera_down/image_raw  (sensor_msgs/Image)
  Frame:       iris/camera_down_link

  Coordinate mapping (downward camera, rpy="0 pi/2 0"):
    camera_link +X  = body -Z (optical axis → altitude)
    optical Z = altitude above tag  (p.z)
    optical X = body -Y direction   (p.x) → vy = -kp * p.x
    optical Y = body -X direction   (p.y) → vx = -kp * p.y
-->
<robot name="$(arg mav_name)" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- iris + odometry sensor + forward vi_sensor (unchanged) -->
  <xacro:include filename="$(find rotors_description)/urdf/mav_with_vi_sensor.gazebo" />

  <!-- ── Downward camera ────────────────────────────────────────────────────── -->
  <!-- camera_macro is already defined via iris_base.xacro → component_snippets.xacro -->
  <xacro:camera_macro
    namespace="${namespace}"
    parent_link="${namespace}/base_link"
    camera_suffix="down"
    frame_rate="30"
    horizontal_fov="1.5708"
    image_width="640"
    image_height="480"
    image_format="R8G8B8"
    min_distance="0.02"
    max_distance="20"
    noise_mean="0.0"
    noise_stddev="0.007"
    enable_visual="false">
    <!-- Mount below body centre, pitch +90° so camera +X points downward -->
    <origin xyz="0 0 -0.06" rpy="0 ${pi/2} 0" />
    <geometry>
      <box><size>0.02 0.02 0.02</size></box>
    </geometry>
  </xacro:camera_macro>

</robot>
